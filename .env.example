# Environment Configuration
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# UserWay Accessibility Widget
# Get your account ID from https://userway.org/dashboard
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# Firebase Configuration (Client-side)
# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Server-side)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI API (for AI press release generation and YouTube transcription)
# Get your API key from https://platform.openai.com/api-keys
# Required for: AI press release generator, YouTube video transcription with Whisper
OPENAI_API_KEY=

# Mattermost Integration
# Get webhook URL from Mattermost > Integrations > Incoming Webhooks
MATTERMOST_WEBHOOK_URL=

# ThomasNet Credentials (for authenticated supplier search)
# Create a free account at https://www.thomasnet.com/register
THOMASNET_EMAIL=
THOMASNET_PASSWORD=

# CONNEX Marketplace Credentials (MEP National Network supplier database)
# Create a free account at https://app.connexmarketplace.com/create-account
# 165,000+ U.S. manufacturers in the database
CONNEX_EMAIL=
CONNEX_PASSWORD=

# ============================================================================
# KDM CONSORTIUM PLATFORM INTEGRATIONS
# ============================================================================

# Stripe Payment Processing
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect for revenue splitting
STRIPE_CONNECT_CLIENT_ID=
# Webhook signing secret from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=

# Email Service (Choose one: SendGrid or Resend)
# SendGrid: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Resend (Alternative to SendGrid): https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@kdm-assoc.com
RESEND_FROM_NAME=Brian Stitt

# SMS Service (Optional - Twilio)
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Zoom Integration (for virtual events)
# Create OAuth app at https://marketplace.zoom.us/
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Platform Configuration
NEXT_PUBLIC_PLATFORM_NAME="KDM Consortium"
NEXT_PUBLIC_PLATFORM_URL=https://consortium.kdmassociates.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@kdmassociates.com

# Add additional environment variables below as needed
# NEXT_PUBLIC_* variables are exposed to the browser
# Variables without NEXT_PUBLIC_ prefix are server-side only

# ============================================================================
# Microsoft Graph API Email (Azure AD)
# ============================================================================
# Preferred method for Office 365 email delivery
# Requires Azure AD App Registration with Mail.Send permission
AZURE_TENANT_ID=          # Azure AD tenant ID (Directory ID)
AZURE_CLIENT_ID=          # App registration client ID
AZURE_CLIENT_SECRET=      # App registration client secret (create in Certificates & secrets)
SMTP_FROM_NAME=KDM & Associates
SMTP_FROM_EMAIL=admin@kdm-assoc.com  # Must be a licensed Exchange user in your tenant

# ============================================================================
# Legacy SMTP (Deprecated - use Graph API above instead)
# ============================================================================
# Only use if Graph API is not available
AZURE_SMTP_HOST=your-smtp-host
AZURE_SMTP_PORT=your-smtp-port
AZURE_SMTP_USERNAME=your-username
AZURE_SMTP_PASSWORD=your-password
AZURE_SMTP_FROM_EMAIL=your-email@domain.com

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=your_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=your_NEXT_PUBLIC_STMONTHLY_PRICE_ID